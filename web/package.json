{
  "name": "leibniz-stepped-reckoner-web",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive 3D simulator of the Leibniz stepped reckoner",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:model": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python ../blender/scripts/build_m0_slice.py && \"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python ../blender/scripts/build_m1_slice.py && \"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python ../blender/scripts/build_m2.py",
    "check:model": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python ../blender/scripts/check_m0_clearance.py && pnpm poses:m1 && \"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python ../blender/scripts/check_m1_clearance.py && pnpm poses:m2 && \"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python ../blender/scripts/check_m2_clearance.py",
    "fixture": "python3 -I ../blender/scripts/export_kinematics_fixture.py",
    "build:model:m1": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python ../blender/scripts/build_m1_slice.py",
    "poses:m1": "EXPORT_POSES=1 vitest run src/tools/exportM1Poses.test.ts",
    "poses:m2": "EXPORT_POSES=1 vitest run src/tools/exportM2Poses.test.ts",
    "build:model:m2": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python ../blender/scripts/build_m2.py"
  },
  "dependencies": {
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
